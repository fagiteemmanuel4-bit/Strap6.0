{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/health?__strap_route=:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/billing/cron",
      "schedule": "0 9 * * *"
    }
  ]
}
