{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource/api/mcp",
      "destination": "/api/health?__strap_route=mcp/resource-metadata"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/health?__strap_route=:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/mcp-login.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/mcp-consent.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/billing/cron",
      "schedule": "0 9 * * *"
    }
  ]
}
